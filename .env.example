# Copy to .env for local development. Never commit real credentials.
# PostgreSQL: both URLs must point to the SAME database.
# DATABASE_URL: pooled runtime URL from Neon/Supabase for Vercel.
# DIRECT_URL: direct connection (or Supabase session pooler) for Prisma migrations.
# Local PostgreSQL can use the same URL for both variables.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smilecare"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/smilecare"

# Authentication: generate a unique secret; use the final HTTPS origin on Vercel.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Used only by npm run db:admin; not required in Vercel runtime settings.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Public values are included in the browser bundle. Never put secrets here.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CLINIC_PHONE="+44 1632 960000"
# Optional, real monitored contact for the portfolio owner. Leave blank if unavailable.
NEXT_PUBLIC_PRIVACY_EMAIL=""

# Recommended for public deployments: shared booking rate limits.
# Without Redis, the development fallback is per process, not per deployment.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Production notification queue: configure all three values together.
# NEXT_PUBLIC_SITE_URL must be reachable by QStash over HTTPS.
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# Optional Telegram delivery. Use only a bot/chat you control.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Email provider: resend or smtp. Use a verified sender and test recipients.
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
EMAIL_FROM=""
EMAIL_ADMIN_TO=""
EMAIL_REPLY_TO=""
# SMTP alternative: secure=true for implicit TLS (usually port 465).
# For STARTTLS (usually port 587), set SMTP_SECURE=false.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""

# Optional image uploads; bundled illustrated avatars do not require Cloudinary.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional AmoCRM integration. Other adapter names are not implemented.
CRM_TYPE="amocrm"
CRM_API_URL=""
CRM_API_TOKEN=""
CRM_RESPONSIBLE_USER_ID=""
