    "@upstash/redis": "^1.34.3",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.29",
    "next-auth": "^4.24.11",
    "nodemailer": "^10.4.0",
    "react": "19.1.1",
    "react-day-picker": "^9.14.0",
